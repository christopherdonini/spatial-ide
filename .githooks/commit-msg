#
# Refuses a commit with no Signed-off-by trailer -- a local, fast mirror of the real gate
# (.github/workflows/dco.yml). This exists because three headed-measurement-session commits
# (viewport-residency cut, 2026-09-02) reached an open PR unsigned before the real gate caught
# them; the fix at the time was a retroactive DCO certification (see DECISIONS-PENDING.md's
# resolved entry 26), not a rewrite -- this hook is the "catch it at commit one, not at PR
# sixteen" half of that resolution. Enable with: git config core.hooksPath .githooks
set -eu

msg_file="$1"

# Matches dco.yml's own scope: merge commits carry no author affirmation to check.
commit_source="${2:-}"
if [ "$commit_source" != "merge" ]; then
  if ! grep -qE '^Signed-off-by: .+ <.+>$' "$msg_file"; then
    echo "error: commit has no Signed-off-by trailer (DCO 1.1 -- see CONTRIBUTING.md)." >&2
    echo "  fix:   git commit -s" >&2
    echo "  amend: git commit --amend -s" >&2
    exit 1
  fi
fi

# Also refuses a commit message carrying a profile path
# (scripts/hooks/EXPOSURE-PROFILE-PATHS-PREREGISTRATION.md 2d, 4.1(i)): the scan runs for every
# commit this hook receives, merges included. This states the scan's own scope only; it makes no
# claim about the DCO check's merge-skip condition above, in either direction (see
# EXPOSURE-PROFILE-PATHS-PREREGISTRATION.md 4.5). Fails closed on the scanner's declared clean line
# (4.1(c)), not on exit status alone.
hook_dir="$(dirname "$0")"
if ! command -v node >/dev/null 2>&1; then
  echo "error: node not found -- the profile-path scan could not run." >&2
  exit 1
fi

set +e
scan_output="$(node "$hook_dir/../scripts/hooks/profile-path-scan.mjs" --message "$msg_file")"
scan_status=$?
set -e

if [ "$scan_status" -eq 0 ] && [ "$scan_output" = "profile-path-scan: clean" ]; then
  exit 0
fi

# 7.1(c): a finding is named only on a declared line -- node's own exit 1 (e.g. a load failure
# before the scanner reaches its own finding logic) prints no such line and is not named a finding.
if [ "$scan_status" -eq 1 ] && [ "$scan_output" = "profile-path-scan: refused" ]; then
  echo "error: commit message refused -- it carries a profile path (see the output above)." >&2
  exit 1
fi

case "$scan_status" in
  2)
    echo "error: commit message refused -- the profile-path scan aborted." >&2
    exit 2
    ;;
  3)
    echo "error: commit message refused -- the profile-path scan's canary was not found." >&2
    exit 3
    ;;
  0|1)
    echo "error: commit message refused -- the profile-path scan reported no result." >&2
    exit 2
    ;;
  *)
    echo "error: commit message refused -- the profile-path scan exited $scan_status." >&2
    exit "$scan_status"
    ;;
esac
